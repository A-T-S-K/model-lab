{
  "name": "model-lab",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/model/*.test.ts tests/trace/*.test.ts tests/integration/*.test.ts tests/app/*.test.ts tests/integration/*.test.mjs",
    "test:reference": "npm run test:reference:portable",
    "test:browser": "playwright test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "acceptance": "npm run test:reference && npm test && npm run example && npm run build && npm run test:browser",
    "test:isolation": "python3 scripts/check_isolation.py",
    "benchmark:capture": "node --expose-gc --import tsx scripts/benchmark-capture.ts",
    "benchmark:training": "node --expose-gc --import tsx scripts/benchmark-training.ts",
    "benchmark:experiments": "node --import tsx scripts/benchmark-experiments.ts",
    "runtime:identity": "node scripts/runtime-identity.mjs",
    "pretypecheck": "npm run runtime:identity",
    "pretest": "npm run runtime:identity",
    "prebenchmark:capture": "npm run runtime:identity",
    "prebenchmark:training": "npm run runtime:identity",
    "prebenchmark:experiments": "npm run runtime:identity",
    "example": "node --import tsx examples/predict-teach.ts",
    "measure:guided": "node --import tsx scripts/measure-guided.ts",
    "test:reference:portable": "python3 -m unittest discover -s tests/reference -v && python3 reference/portable_conformance.py",
    "test:reference:canonical": "python3 -m unittest discover -s tests/canonical -v && python3 reference/generate_fixture.py --check",
    "prepare:abq": "node scripts/prepare-abq.mjs",
    "qualify:public": "node --import tsx scripts/qualify-public-experience.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0"
  }
}
